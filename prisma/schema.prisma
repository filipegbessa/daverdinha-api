// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model BotSettings {
  id                             Int      @id @default(1)
  botEnabled                     Boolean  @default(false) @map("bot_enabled")
  welcomeMessage                 String   @map("welcome_message")
  invalidAttemptsExceededMessage String   @default("Não consegui entender sua opção, vou te chamar um atendente!") @map("invalid_attempts_exceeded_message")
  mediaReceivedMessage           String   @default("Esse tipo de mensagem não é válido por aqui!") @map("media_received_message")
  orderReceivedMessage           String   @default("Aceito! Recebemos seu pedido, já vamos confirmar com você.") @map("order_received_message")
  /// Bytes de mídia em uso no R2, somado ao vivo na mesma transação que
  /// grava cada mensagem (ConversationMessengerService.persist). Tem que
  /// ser BigInt: em bytes, o teto de 8 GB são ~8,6 bilhões — um Int do
  /// Postgres estoura em ~2,1 bilhões e o teto nunca dispararia.
  mediaBytesUsed                 BigInt   @default(0) @map("media_bytes_used")
  updatedAt                      DateTime @updatedAt @map("updated_at")

  @@map("bot_settings")
}

// One row per option the customer sees in the WhatsApp menu. Exactly one
// row is `isSystem` — the delivery-location flow, which answers from its
// own `delivery*` messages instead of the plain `reply` every other item
// uses. System items can be edited but never created or deleted.
model MenuItem {
  id                          String   @id @default(uuid())
  order                       Int
  topic                       String
  isSystem                    Boolean  @default(false) @map("is_system")
  reply                       String?
  deliveryPrompt              String?  @map("delivery_prompt")
  deliveryRetryMessage        String?  @map("delivery_retry_message")
  deliveryConfirmedMessage    String?  @map("delivery_confirmed_message")
  deliveryNotCoveredMessage   String?  @map("delivery_not_covered_message")
  deliveryUnrecognizedMessage String?  @map("delivery_unrecognized_message")
  active                      Boolean  @default(true)
  createdAt                   DateTime @default(now()) @map("created_at")
  updatedAt                   DateTime @updatedAt @map("updated_at")

  @@map("menu_items")
}

model DeliveryLocation {
  id         String        @id @default(uuid())
  zone       String
  regionName String        @unique @map("region_name")
  covered    Boolean       @default(true)
  cepRanges  CepRange[]
  /// Área de entrega do site (subdivisão da zona, com valor). Sem área, o
  /// site não entrega no bairro mesmo que ele esteja coberto pelo bot.
  areaId     String?       @map("area_id")
  area       DeliveryArea? @relation(fields: [areaId], references: [id], onDelete: SetNull)
  createdAt  DateTime      @default(now()) @map("created_at")
  updatedAt  DateTime      @updatedAt @map("updated_at")

  @@index([areaId])
  @@map("delivery_locations")
}

/// Subdivisão de uma zona com valor de entrega próprio. Bairro coberto sem
/// área = entrega indisponível no site, nunca frete grátis.
model DeliveryArea {
  id        String             @id @default(uuid())
  zone      String
  name      String
  fee       Decimal            @db.Decimal(10, 2)
  locations DeliveryLocation[]
  createdAt DateTime           @default(now()) @map("created_at")
  updatedAt DateTime           @updatedAt @map("updated_at")

  @@unique([zone, name])
  @@map("delivery_areas")
}

model CepRange {
  id                 Int              @id @default(autoincrement())
  startCep           Int              @map("start_cep")
  endCep             Int              @map("end_cep")
  deliveryLocationId String           @map("delivery_location_id")
  deliveryLocation   DeliveryLocation @relation(fields: [deliveryLocationId], references: [id], onDelete: Cascade)

  @@index([startCep, endCep])
  @@map("cep_ranges")
}

enum ConversationStatus {
  bot_active
  paused_human
}

enum EntryPoint {
  menu
  catalog
}

model Conversation {
  id                    String                 @id @default(uuid())
  phone                 String
  name                  String?
  status                ConversationStatus     @default(bot_active)
  entryPoint            EntryPoint?            @map("entry_point")
  invalidAttempts       Int                    @default(0) @map("invalid_attempts")
  awaitingDeliveryReply Boolean                @default(false) @map("awaiting_delivery_reply")
  /// True while the last message is one the customer sent. Maintained by
  /// ConversationMessengerService on every write rather than derived, so the
  /// admin list and the unread badge never have to fetch each conversation's
  /// last message just to colour a dot.
  unread                Boolean                @default(false)
  createdAt             DateTime               @default(now()) @map("created_at")
  updatedAt             DateTime               @updatedAt @map("updated_at")
  messages              Message[]
  orders                Order[]
  categories            ConversationCategory[]

  // The admin list sorts by updatedAt and the bot looks a conversation up by
  // phone on every single inbound message — neither had an index, and Postgres
  // does not create one for a foreign key on its own.
  @@index([updatedAt(sort: Desc)])
  @@index([phone])
  @@index([unread])
  @@map("conversations")
}

enum MessageDirection {
  inbound
  outbound
}

enum MessageKind {
  text
  invalid_content
  order
  image
  audio
}

model Message {
  id                String           @id @default(uuid())
  conversationId    String           @map("conversation_id")
  conversation      Conversation     @relation(fields: [conversationId], references: [id])
  direction         MessageDirection
  kind              MessageKind      @default(text)
  body              String?
  order             Order?
  /// Chave do arquivo no bucket. Nulo em mensagem sem mídia, e também na que
  /// já teve a mídia expurgada pela retenção — o registro de que o cliente
  /// mandou algo continua, o arquivo não.
  mediaKey          String?          @map("media_key")
  mediaMimeType     String?          @map("media_mime_type")
  /// Alimenta o total em uso, que é somado na mesma transação que grava a
  /// mensagem. É esse número que faz o teto de armazenamento ser imediato em
  /// vez de depender do cron diário.
  mediaSizeBytes    Int?             @map("media_size_bytes")
  whatsappMessageId String?          @unique @map("whatsapp_message_id")
  repliedToWamid    String?          @map("replied_to_wamid")
  repliedToId       String?          @map("replied_to_id")
  repliedTo         Message?         @relation("MessageReplies", fields: [repliedToId], references: [id], onDelete: SetNull)
  replies           Message[]        @relation("MessageReplies")
  createdAt         DateTime         @default(now()) @map("created_at")

  // Every read of a thread is "this conversation, in time order" — as a page,
  // as a delta poll, or as older history.
  @@index([conversationId, createdAt])
  @@map("messages")
}

model Order {
  id             String       @id @default(uuid())
  conversationId String       @map("conversation_id")
  conversation   Conversation @relation(fields: [conversationId], references: [id])
  messageId      String       @unique @map("message_id")
  message        Message      @relation(fields: [messageId], references: [id], onDelete: Cascade)
  catalogId      String       @map("catalog_id")
  items          OrderItem[]
  createdAt      DateTime     @default(now()) @map("created_at")

  @@map("orders")
}

model OrderItem {
  id                String   @id @default(uuid())
  orderId           String   @map("order_id")
  order             Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productRetailerId String   @map("product_retailer_id")
  productName       String?  @map("product_name")
  quantity          Int
  unitPrice         Decimal? @map("unit_price") @db.Decimal(10, 2)
  currency          String?
  createdAt         DateTime @default(now()) @map("created_at")

  @@map("order_items")
}

// Guards against WhatsApp's webhook retries (e.g. our endpoint didn't ack
// fast enough) reprocessing the same inbound message — without this, a
// retried "oi" looks like an unrecognized reply to whatever the bot already
// answered with, cycling invalidAttempts and eventually escalating to a
// human for no reason. whatsappMessageId is the Cloud API's own wamid,
// already globally unique, so it doubles as the primary key.
model ProcessedWebhookMessage {
  whatsappMessageId String   @id @map("whatsapp_message_id")
  createdAt         DateTime @default(now()) @map("created_at")

  @@map("processed_webhook_messages")
}

model PushSubscription {
  id          String   @id @default(uuid())
  clerkUserId String   @map("clerk_user_id")
  endpoint    String   @unique
  p256dh      String
  auth        String
  createdAt   DateTime @default(now()) @map("created_at")

  @@map("push_subscriptions")
}

model Category {
  id            String                 @id @default(uuid())
  name          String                 @unique
  /// Free-form hex (#rrggbb) chosen by the admin from a colour input.
  color         String
  createdAt     DateTime               @default(now()) @map("created_at")
  conversations ConversationCategory[]

  @@map("categories")
}

model ConversationCategory {
  conversationId String       @map("conversation_id")
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  categoryId     String       @map("category_id")
  category       Category     @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  createdAt      DateTime     @default(now()) @map("created_at")

  @@id([conversationId, categoryId])
  @@map("conversation_categories")
}

/// Categoria do catálogo do site ("Vasos", "Mudas"…). Não confundir com
/// `Category`, que etiqueta conversas no admin.
model ProductCategory {
  id          String    @id @default(uuid())
  name        String    @unique
  /// Gerado do nome na criação e nunca recalculado: é a URL `/produtos/[slug]`
  /// do site, e mudar depois de indexada quebra link.
  slug        String    @unique
  /// Texto de abertura da página da categoria no site.
  description String    @default("")
  active      Boolean   @default(true)
  order       Int       @default(0)
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  products    Product[]

  @@map("product_categories")
}

model Product {
  id           String          @id @default(uuid())
  name         String
  /// Único no catálogo inteiro, não por categoria: o site acha o produto só
  /// pelo slug e redireciona se a categoria da URL estiver desatualizada.
  slug         String          @unique
  description  String
  price        Decimal         @db.Decimal(10, 2)
  /// URLs públicas no Vercel Blob; a primeira é a capa.
  images       String[]
  categoryId   String          @map("category_id")
  // Sem onDelete: RESTRICT, então apagar uma categoria com produto falha
  // (P2003) em vez de levar os produtos junto.
  category     ProductCategory @relation(fields: [categoryId], references: [id])
  active       Boolean         @default(true)
  /// Aparece na vitrine da home e nas listas das páginas internas (agenda).
  featured     Boolean         @default(false)
  order        Int             @default(0)
  /// Com número: pronta entrega, e 0 disponível é esgotado. `null` = sob
  /// encomenda (vende sem limite e usa `leadTimeDays`).
  stock        Int?
  /// Prazo de confecção em dias; obrigatório quando `stock` é `null`. Fica
  /// guardado ao voltar pra pronta entrega, pra reaparecer se mudar de novo.
  leadTimeDays Int?            @map("lead_time_days")
  orderItems   SiteOrderItem[]
  /// Removido no admin: some do site e do admin, mas a linha (e as fotos)
  /// fica pra os pedidos antigos continuarem apontando pro produto.
  archivedAt   DateTime?       @map("archived_at")
  createdAt    DateTime        @default(now()) @map("created_at")
  updatedAt    DateTime        @updatedAt @map("updated_at")

  @@index([active, order])
  @@index([categoryId])
  @@map("products")
}

enum SiteOrderStatus {
  pending_payment
  paid
  expired
  cancelled
  refunded
}

enum FulfillmentStatus {
  awaiting
  preparing
  ready
  completed
}

enum DeliveryMethod {
  pickup
  delivery
}

/// Já nasce com os dois tipos, mesmo que os ingressos venham depois: assim o
/// schema dos ingressos só cria tabela/coluna, sem `ALTER ... DROP NOT NULL`.
enum SiteOrderKind {
  products
  tickets
}

/// Pedido feito no site (carrinho ou ingresso + Pagar.me). Não confundir com
/// `Order`, que é o pedido de catálogo recebido pelo WhatsApp.
model SiteOrder {
  id                String            @id @default(uuid())
  /// Vira o código `DV-0001` mostrado pra cliente e pro comprador.
  number            Int               @unique @default(autoincrement())
  /// Vai na URL pública do pedido; o número é sequencial e não pode ser.
  publicToken       String            @unique @default(uuid()) @map("public_token")
  kind              SiteOrderKind     @default(products)
  status            SiteOrderStatus   @default(pending_payment)
  fulfillmentStatus FulfillmentStatus @default(awaiting) @map("fulfillment_status")
  customerName      String            @map("customer_name")
  customerEmail     String            @map("customer_email")
  customerPhone     String            @map("customer_phone")
  /// `null` em pedido de ingresso (não tem entrega).
  deliveryMethod    DeliveryMethod?   @map("delivery_method")
  cep               String?
  street            String?
  streetNumber      String?           @map("street_number")
  complement        String?
  bairro            String?
  /// Snapshot do nome da zona e da área no momento do pedido.
  deliveryZone      String?           @map("delivery_zone")
  deliveryArea      String?           @map("delivery_area")
  notes             String?
  subtotal          Decimal           @db.Decimal(10, 2)
  deliveryFee       Decimal           @map("delivery_fee") @db.Decimal(10, 2)
  total             Decimal           @db.Decimal(10, 2)
  /// Link de pagamento (`pl_…`), pedido (`or_…`) e cobrança (`ch_…`) no
  /// Pagar.me. Nomes neutros de propósito: só `src/pagarme/` sabe o formato.
  gatewayLinkId     String?           @unique @map("gateway_link_id")
  gatewayOrderId    String?           @unique @map("gateway_order_id")
  gatewayChargeId   String?           @map("gateway_charge_id")
  gatewayStatus     String?           @map("gateway_status")
  paymentUrl        String?           @map("payment_url")
  paidAt            DateTime?         @map("paid_at")
  expiresAt         DateTime          @map("expires_at")
  lastSyncedAt      DateTime?         @map("last_synced_at")
  items             SiteOrderItem[]
  /// Só em pedido de ingresso. Restrict: evento com venda não pode ser apagado.
  eventId           String?           @map("event_id")
  event             Event?            @relation(fields: [eventId], references: [id], onDelete: Restrict)
  tickets           SiteOrderTicket[]
  createdAt         DateTime          @default(now()) @map("created_at")
  updatedAt         DateTime          @updatedAt @map("updated_at")

  @@index([kind, status, createdAt])
  @@index([eventId, status])
  @@map("site_orders")
}

/// Um ingresso = um participante. Preço congelado no momento da compra.
model SiteOrderTicket {
  id           String    @id @default(uuid())
  orderId      String    @map("order_id")
  order        SiteOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  eventId      String    @map("event_id")
  event        Event     @relation(fields: [eventId], references: [id], onDelete: Restrict)
  attendeeName String    @map("attendee_name")
  unitPrice    Decimal   @map("unit_price") @db.Decimal(10, 2)
  checkedInAt  DateTime? @map("checked_in_at")

  @@index([eventId])
  @@index([orderId])
  @@map("site_order_tickets")
}

model SiteOrderItem {
  id           String    @id @default(uuid())
  orderId      String    @map("order_id")
  order        SiteOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  /// SetNull: o produto pode ser excluído depois; o pedido guarda a foto do momento.
  productId    String?   @map("product_id")
  product      Product?  @relation(fields: [productId], references: [id], onDelete: SetNull)
  productName  String    @map("product_name")
  productSlug  String?   @map("product_slug")
  imageUrl     String?   @map("image_url")
  unitPrice    Decimal   @map("unit_price") @db.Decimal(10, 2)
  quantity     Int
  /// Snapshot: `null` = pronta entrega; número = sob encomenda com esse prazo.
  leadTimeDays Int?      @map("lead_time_days")

  @@index([orderId])
  @@index([productId])
  @@map("site_order_items")
}

/// Configurações da loja editadas no admin. Linha única (id = 1), como
/// `BotSettings`; o service cria com os valores padrão se ela não existir.
model StoreSettings {
  id                  Int      @id @default(1)
  /// Liga o site completo em `/`. Desligado, `/` mostra a página "em breve"
  /// e o site completo fica só na prévia `/site`. Liga e desliga no Dashboard.
  siteEnabled         Boolean  @default(false) @map("site_enabled")
  /// Liga a venda pelo site (carrinho + Pagar.me). Desligada, o site vende
  /// pelo WhatsApp e o checkout da API recusa pedidos.
  storeEnabled        Boolean  @default(false) @map("store_enabled")
  /// Liga a venda de ingressos pelo site, independente da loja. Um evento só
  /// vende com este ligado e o `ticketSales` dele ligado.
  ticketsEnabled      Boolean  @default(false) @map("tickets_enabled")
  pickupEnabled       Boolean  @default(true) @map("pickup_enabled")
  pickupAddress       String   @map("pickup_address")
  pickupHours         String   @map("pickup_hours")
  pickupInstructions  String?  @map("pickup_instructions")
  /// Parcelamento sem juros pro comprador: até `maxInstallments`, desde que
  /// cada parcela fique em pelo menos `minInstallmentValue`.
  maxInstallments     Int      @default(3) @map("max_installments")
  minInstallmentValue Decimal  @default(30) @map("min_installment_value") @db.Decimal(10, 2)
  updatedAt           DateTime @updatedAt @map("updated_at")

  @@map("store_settings")
}

/// Evento da agenda do site (oficina, feirinha, aula). Rascunho até
/// `published`; evento passado sai da lista pública sozinho pelo `endsAt`,
/// mas a página dele continua no ar.
model Event {
  id                 String            @id @default(uuid())
  title              String
  /// Gerado do título na criação e nunca recalculado: é a URL do evento.
  slug               String            @unique
  description        String
  startsAt           DateTime          @map("starts_at")
  endsAt             DateTime          @map("ends_at")
  /// `null` = no ateliê (o site usa o endereço da loja).
  locationName       String?           @map("location_name")
  locationAddress    String?           @map("location_address")
  /// `null` = gratuito.
  price              Decimal?          @db.Decimal(10, 2)
  /// `null` = sem limite divulgado.
  spots              Int?
  imageUrl           String?           @map("image_url")
  /// `null` = inscrição pelo WhatsApp, com mensagem pronta montada pelo site.
  ctaUrl             String?           @map("cta_url")
  published          Boolean           @default(false)
  /// Venda/inscrição pelo site. Desligada, o evento usa `ctaUrl`/WhatsApp.
  /// Só vale com o interruptor geral `StoreSettings.ticketsEnabled` ligado.
  ticketSales        Boolean           @default(false) @map("ticket_sales")
  /// Limite de ingressos por compra, configurado pela cliente (1–50).
  maxTicketsPerOrder Int               @default(10) @map("max_tickets_per_order")
  tickets            SiteOrderTicket[]
  orders             SiteOrder[]
  createdAt          DateTime          @default(now()) @map("created_at")
  updatedAt          DateTime          @updatedAt @map("updated_at")

  @@index([published, endsAt])
  @@map("events")
}
