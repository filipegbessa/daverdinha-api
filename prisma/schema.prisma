// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model BotSettings {
  id                             Int      @id @default(1)
  botEnabled                     Boolean  @default(false) @map("bot_enabled")
  welcomeMessage                 String   @map("welcome_message")
  menuPrompt                     String   @default("Como posso te ajudar hoje?") @map("menu_prompt")
  deliveryPrompt                 String   @map("delivery_prompt")
  deliveryWaitMessage            String   @map("delivery_wait_message")
  deliveryNotCoveredMessage      String   @default("Poxa, ainda não entregamos nessa região 💚") @map("delivery_not_covered_message")
  deliveryUnrecognizedMessage    String   @default("Não consegui identificar essa região, vou te chamar um atendente!") @map("delivery_unrecognized_message")
  invalidAttemptsExceededMessage String   @default("Não consegui entender sua opção, vou te chamar um atendente!") @map("invalid_attempts_exceeded_message")
  updatedAt                      DateTime @updatedAt @map("updated_at")

  @@map("bot_settings")
}

enum MenuItemType {
  texto
  entrega
  atendente
  pergunta
}

model MenuItem {
  id                    String                 @id @default(uuid())
  order                 Int
  topic                 String
  type                  MenuItemType
  reply                 String?
  question              String?                @map("question")
  noMatchReply          String?                @map("no_match_reply")
  active                Boolean                @default(true)
  createdAt             DateTime               @default(now()) @map("created_at")
  updatedAt             DateTime               @updatedAt @map("updated_at")
  answerOptions         MenuItemAnswerOption[]
  awaitingConversations Conversation[]

  @@map("menu_items")
}

model MenuItemAnswerOption {
  id         String   @id @default(uuid())
  menuItemId String   @map("menu_item_id")
  menuItem   MenuItem @relation(fields: [menuItemId], references: [id], onDelete: Cascade)
  keywords   String[] @map("keywords")
  reply      String
  order      Int      @default(0)
  createdAt  DateTime @default(now()) @map("created_at")

  @@map("menu_item_answer_options")
}

model DeliveryLocation {
  id         String   @id @default(uuid())
  zone       String
  regionName String   @map("region_name")
  covered    Boolean  @default(true)
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  @@map("delivery_locations")
}

enum ConversationStatus {
  bot_active
  paused_human
}

enum EntryPoint {
  menu
  catalog
}

model Conversation {
  id                       String             @id @default(uuid())
  phone                    String
  name                     String?
  status                   ConversationStatus @default(bot_active)
  entryPoint               EntryPoint?        @map("entry_point")
  invalidAttempts          Int                @default(0) @map("invalid_attempts")
  awaitingDeliveryReply    Boolean            @default(false) @map("awaiting_delivery_reply")
  awaitingMenuItemAnswerId String?            @map("awaiting_menu_item_answer_id")
  awaitingMenuItemAnswer   MenuItem?          @relation(fields: [awaitingMenuItemAnswerId], references: [id], onDelete: SetNull)
  createdAt                DateTime           @default(now()) @map("created_at")
  updatedAt                DateTime           @updatedAt @map("updated_at")
  messages                 Message[]

  @@map("conversations")
}

enum MessageDirection {
  inbound
  outbound
}

model Message {
  id             String           @id @default(uuid())
  conversationId String           @map("conversation_id")
  conversation   Conversation     @relation(fields: [conversationId], references: [id])
  direction      MessageDirection
  body           String
  createdAt      DateTime         @default(now()) @map("created_at")

  @@map("messages")
}
