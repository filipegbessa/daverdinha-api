// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model BotSettings {
  id                             Int      @id @default(1)
  botEnabled                     Boolean  @default(false) @map("bot_enabled")
  welcomeMessage                 String   @map("welcome_message")
  invalidAttemptsExceededMessage String   @default("Não consegui entender sua opção, vou te chamar um atendente!") @map("invalid_attempts_exceeded_message")
  mediaReceivedMessage           String   @default("Esse tipo de mensagem não é válido por aqui!") @map("media_received_message")
  orderReceivedMessage           String   @default("Aceito! Recebemos seu pedido, já vamos confirmar com você.") @map("order_received_message")
  /// Bytes de mídia em uso no R2, somado ao vivo na mesma transação que
  /// grava cada mensagem (ConversationMessengerService.persist). Tem que
  /// ser BigInt: em bytes, o teto de 8 GB são ~8,6 bilhões — um Int do
  /// Postgres estoura em ~2,1 bilhões e o teto nunca dispararia.
  mediaBytesUsed                 BigInt   @default(0) @map("media_bytes_used")
  updatedAt                      DateTime @updatedAt @map("updated_at")

  @@map("bot_settings")
}

// One row per option the customer sees in the WhatsApp menu. Exactly one
// row is `isSystem` — the delivery-location flow, which answers from its
// own `delivery*` messages instead of the plain `reply` every other item
// uses. System items can be edited but never created or deleted.
model MenuItem {
  id                          String   @id @default(uuid())
  order                       Int
  topic                       String
  isSystem                    Boolean  @default(false) @map("is_system")
  reply                       String?
  deliveryPrompt              String?  @map("delivery_prompt")
  deliveryRetryMessage        String?  @map("delivery_retry_message")
  deliveryConfirmedMessage    String?  @map("delivery_confirmed_message")
  deliveryNotCoveredMessage   String?  @map("delivery_not_covered_message")
  deliveryUnrecognizedMessage String?  @map("delivery_unrecognized_message")
  active                      Boolean  @default(true)
  createdAt                   DateTime @default(now()) @map("created_at")
  updatedAt                   DateTime @updatedAt @map("updated_at")

  @@map("menu_items")
}

model DeliveryLocation {
  id         String     @id @default(uuid())
  zone       String
  regionName String     @unique @map("region_name")
  covered    Boolean    @default(true)
  cepRanges  CepRange[]
  createdAt  DateTime   @default(now()) @map("created_at")
  updatedAt  DateTime   @updatedAt @map("updated_at")

  @@map("delivery_locations")
}

model CepRange {
  id                 Int              @id @default(autoincrement())
  startCep           Int              @map("start_cep")
  endCep             Int              @map("end_cep")
  deliveryLocationId String           @map("delivery_location_id")
  deliveryLocation   DeliveryLocation @relation(fields: [deliveryLocationId], references: [id], onDelete: Cascade)

  @@index([startCep, endCep])
  @@map("cep_ranges")
}

enum ConversationStatus {
  bot_active
  paused_human
}

enum EntryPoint {
  menu
  catalog
}

model Conversation {
  id                    String                 @id @default(uuid())
  phone                 String
  name                  String?
  status                ConversationStatus     @default(bot_active)
  entryPoint            EntryPoint?            @map("entry_point")
  invalidAttempts       Int                    @default(0) @map("invalid_attempts")
  awaitingDeliveryReply Boolean                @default(false) @map("awaiting_delivery_reply")
  /// True while the last message is one the customer sent. Maintained by
  /// ConversationMessengerService on every write rather than derived, so the
  /// admin list and the unread badge never have to fetch each conversation's
  /// last message just to colour a dot.
  unread                Boolean                @default(false)
  createdAt             DateTime               @default(now()) @map("created_at")
  updatedAt             DateTime               @updatedAt @map("updated_at")
  messages              Message[]
  orders                Order[]
  categories            ConversationCategory[]

  // The admin list sorts by updatedAt and the bot looks a conversation up by
  // phone on every single inbound message — neither had an index, and Postgres
  // does not create one for a foreign key on its own.
  @@index([updatedAt(sort: Desc)])
  @@index([phone])
  @@index([unread])
  @@map("conversations")
}

enum MessageDirection {
  inbound
  outbound
}

enum MessageKind {
  text
  invalid_content
  order
  image
}

model Message {
  id                 String           @id @default(uuid())
  conversationId     String           @map("conversation_id")
  conversation       Conversation     @relation(fields: [conversationId], references: [id])
  direction          MessageDirection
  kind               MessageKind      @default(text)
  body               String?
  order              Order?
  /// Chave do arquivo no bucket. Nulo em mensagem sem mídia, e também na que
  /// já teve a mídia expurgada pela retenção — o registro de que o cliente
  /// mandou algo continua, o arquivo não.
  mediaKey           String?          @map("media_key")
  mediaMimeType      String?          @map("media_mime_type")
  /// Alimenta o total em uso, que é somado na mesma transação que grava a
  /// mensagem. É esse número que faz o teto de armazenamento ser imediato em
  /// vez de depender do cron diário.
  mediaSizeBytes     Int?             @map("media_size_bytes")
  whatsappMessageId  String?          @unique @map("whatsapp_message_id")
  repliedToWamid     String?          @map("replied_to_wamid")
  repliedToId        String?          @map("replied_to_id")
  repliedTo          Message?         @relation("MessageReplies", fields: [repliedToId], references: [id], onDelete: SetNull)
  replies            Message[]        @relation("MessageReplies")
  createdAt          DateTime         @default(now()) @map("created_at")

  // Every read of a thread is "this conversation, in time order" — as a page,
  // as a delta poll, or as older history.
  @@index([conversationId, createdAt])
  @@map("messages")
}

model Order {
  id             String       @id @default(uuid())
  conversationId String       @map("conversation_id")
  conversation   Conversation @relation(fields: [conversationId], references: [id])
  messageId      String       @unique @map("message_id")
  message        Message      @relation(fields: [messageId], references: [id], onDelete: Cascade)
  catalogId      String       @map("catalog_id")
  items          OrderItem[]
  createdAt      DateTime     @default(now()) @map("created_at")

  @@map("orders")
}

model OrderItem {
  id                String   @id @default(uuid())
  orderId           String   @map("order_id")
  order             Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productRetailerId String   @map("product_retailer_id")
  productName       String?  @map("product_name")
  quantity          Int
  unitPrice         Decimal? @map("unit_price") @db.Decimal(10, 2)
  currency          String?
  createdAt         DateTime @default(now()) @map("created_at")

  @@map("order_items")
}

// Guards against WhatsApp's webhook retries (e.g. our endpoint didn't ack
// fast enough) reprocessing the same inbound message — without this, a
// retried "oi" looks like an unrecognized reply to whatever the bot already
// answered with, cycling invalidAttempts and eventually escalating to a
// human for no reason. whatsappMessageId is the Cloud API's own wamid,
// already globally unique, so it doubles as the primary key.
model ProcessedWebhookMessage {
  whatsappMessageId String   @id @map("whatsapp_message_id")
  createdAt         DateTime @default(now()) @map("created_at")

  @@map("processed_webhook_messages")
}

model PushSubscription {
  id          String   @id @default(uuid())
  clerkUserId String   @map("clerk_user_id")
  endpoint    String   @unique
  p256dh      String
  auth        String
  createdAt   DateTime @default(now()) @map("created_at")

  @@map("push_subscriptions")
}

model Category {
  id            String                 @id @default(uuid())
  name          String                 @unique
  /// Free-form hex (#rrggbb) chosen by the admin from a colour input.
  color         String
  createdAt     DateTime               @default(now()) @map("created_at")
  conversations ConversationCategory[]

  @@map("categories")
}

model ConversationCategory {
  conversationId String       @map("conversation_id")
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  categoryId     String       @map("category_id")
  category       Category     @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  createdAt      DateTime     @default(now()) @map("created_at")

  @@id([conversationId, categoryId])
  @@map("conversation_categories")
}
